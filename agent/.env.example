# Local Team Agent (one per employee). Copy to agent/.env
TEAM_SERVER_URL=http://localhost:8000
# Issued in the dashboard: sign in -> "Agent token"
TEAM_AGENT_TOKEN=
# Claude API key of this employee (https://platform.claude.com)
ANTHROPIC_API_KEY=

# Optional
# TEAM_AGENT_WORKSPACE=C:\Users\me\team-agent-workspace
# TEAM_AGENT_MODEL=claude-opus-5-5
# TEAM_AGENT_MAX_BUDGET_USD=5
# TEAM_AGENT_RECOVERY_MODE=resume      # or: ask
# TEAM_AGENT_LOCAL_PORT=8765
# TEAM_AGENT_PROFILE=default           # separate data dir per agent on one machine
# TEAM_AGENT_POLICY_FILE=C:\path\to\policy.json
