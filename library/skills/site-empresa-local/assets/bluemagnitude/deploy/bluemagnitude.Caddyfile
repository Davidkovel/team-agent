# Blue Magnitude — Next.js com output: "export".
#
# Montado em ~/sites/bluemagnitude.Caddyfile e serve o /out que está dentro da
# imagem bluemagnitude_site. Deriva do ~/sites/primeview.Caddyfile: cada regra
# abaixo existe por uma razão que já custou um bug neste servidor.
#
# O hostname público e o TLS são tratados pelo caddy_proxy, não aqui.
:80 {
	root * /srv
	encode zstd gzip

	# Assets com hash no nome: cache imutável. Tem de vir ANTES do @hidden,
	# senão o /_* do matcher de ficheiros internos matava o /_next/* todo e o
	# site ficava sem CSS nem JS.
	handle /_next/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Payloads do App Router. Também antes do @hidden: os da raiz começam por
	# /_ e eram apanhados pelo /_*, enquanto os das subpáginas escapavam, e essa
	# assimetria fazia a navegação de volta à homepage cair em reload completo.
	handle /__next* {
		header Cache-Control "no-cache"
		file_server
	}

	@hidden path */.* /_*
	@repo path /README.md /docs/* /deploy/* /src/* /package.json /package-lock.json /next.config.ts /tsconfig.json /postcss.config.mjs /.git/*

	# handle e não respond: o Caddy reordena diretivas soltas e o try_files
	# ficava a correr primeiro, devolvendo 200 a qualquer caminho.
	handle @hidden {
		respond 404
	}
	handle @repo {
		respond 404
	}

	handle {
		# Documentos a no-cache e media versionada no nome a 30 dias. Sem isto o
		# Safari guarda o HTML por heurística e um cliente fica a ver a página
		# de ontem, que aponta para o vídeo antigo do herói.
		@media path *.mp4 *.webm *.webp *.jpg *.jpeg *.png *.svg *.ico *.woff2
		header @media Cache-Control "public, max-age=2592000"

		@doc not path *.mp4 *.webm *.webp *.jpg *.jpeg *.png *.svg *.ico *.woff2
		header @doc Cache-Control "no-cache"

		header {
			X-Content-Type-Options "nosniff"
			Referrer-Policy "strict-origin-when-cross-origin"
		}

		# sem /404.html no try_files: com ele, um caminho inexistente devolvia 200
		# com o corpo da pagina de erro, e o Google indexava lixo como pagina boa
		try_files {path} {path}/ {path}.html
		file_server
	}

	handle_errors {
		# o status tem de continuar a ser 404, so o corpo e que e a nossa pagina
		@404 expression {err.status_code} == 404
		handle @404 {
			rewrite * /404.html
			file_server {
				status 404
			}
		}
		respond "{err.status_code} {err.status_text}"
	}
}
